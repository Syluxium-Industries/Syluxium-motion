#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
#include "flow_common.glsl"
layout(binding = 1) uniform sampler smp;
layout(binding = 2) uniform texture2D src;
layout(binding = 3, rg16f) uniform writeonly image2D dst;

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(dst);
    if (any(greaterThanEqual(p, size))) return;
    const vec2 uv = (vec2(p) + 0.5) / vec2(size);
    const vec2 texel = 1.0 / vec2(size);
    const float w[4] = float[](1.0, 3.0, 3.0, 1.0);
    vec3 c = vec3(0.0);
    for (int y = 0; y < 4; ++y)
        for (int x = 0; x < 4; ++x)
            c += w[x] * w[y] * texture(sampler2D(src, smp), uv + (vec2(x, y) - 1.5) * 0.5 * texel).rgb;
    c /= 64.0;
    const float chroma = C.hdr != 0u ? (c.r - c.b) / (1.0 + max(c.r, c.b)) : c.r - c.b;
    imageStore(dst, p, vec4(luma(c), chroma, 0.0, 0.0));
}
