layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler smp;
layout(binding = 1) uniform texture2D prevL;
layout(binding = 2) uniform texture2D curL;
layout(binding = 3) uniform texture2D coarse;
layout(binding = 4) uniform texture2D history;
layout(binding = 5, rg32f) uniform writeonly image2D dst;

const int kBlock = 4;
const float kUnknown = 0.02;
const int kWin = 4;
const float kSmooth = 0.004;
const float kFarJump = 0.015;

vec2 levelSize;

float cost(vec2 centre, vec2 v) {
    vec2 a[16], b[16];
    float w[16];
    vec2 ma = vec2(0.0), mb = vec2(0.0);
    float n = 0.0;
    int i = 0;
    for (int y = -kWin; y < kWin; y += 2)
        for (int x = -kWin; x < kWin; x += 2, ++i) {
            const vec2 q = centre + vec2(x, y) + 0.5;
            const vec2 qa = (q - 0.5 * v) / levelSize, qb = (q + 0.5 * v) / levelSize;
            const vec2 lo = min(qa, qb), hi = max(qa, qb);
            w[i] = lo.x >= 0.0 && lo.y >= 0.0 && hi.x <= 1.0 && hi.y <= 1.0 ? 1.0 : 0.0;
            a[i] = textureLod(sampler2D(prevL, smp), qa, 0.0).rg;
            b[i] = textureLod(sampler2D(curL, smp), qb, 0.0).rg;
            ma += w[i] * a[i];
            mb += w[i] * b[i];
            n += w[i];
        }
    if (n < 6.0) return kUnknown;
    ma /= n;
    mb /= n;
    float s = 0.0, va = 0.0, vb = 0.0, cov = 0.0;
    for (int j = 0; j < 16; ++j) {
        const vec2 da = a[j] - ma, db = b[j] - mb;
        s += w[j] * (abs(da.x - db.x) + abs(da.y - db.y));
        va += w[j] * dot(da, da);
        vb += w[j] * dot(db, db);
        cov += w[j] * dot(da, db);
    }
    const float zsad = s / n;
    const float energy = sqrt(va * vb);
    const float ncc = energy > 1e-8 ? cov / energy : 1.0;
    const float textured = clamp(sqrt(min(va, vb) / n) / 0.02, 0.0, 1.0);
    return mix(zsad, 0.1 * (1.0 - ncc), textured);
}

void main() {
    const ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 grid = imageSize(dst);
    if (any(greaterThanEqual(b, grid))) return;
    levelSize = vec2(textureSize(sampler2D(curL, smp), 0));
    const vec2 centre = (vec2(b) + 0.5) * float(kBlock);

    const ivec2 cgrid = textureSize(sampler2D(coarse, smp), 0);
    const bool coarsest = cgrid.x <= 1;

    vec2 best = vec2(0.0);
    vec2 pred = vec2(0.0);
    if (!coarsest) {
        const ivec2 cb = clamp(b / 2, ivec2(0), cgrid - 1);
        pred = texelFetch(sampler2D(coarse, smp), cb, 0).xy * levelSize;
    }
    float bestCost = cost(centre, best) + kSmooth * length(best - pred);
    if (!coarsest) {
        const ivec2 cb = clamp(b / 2, ivec2(0), cgrid - 1);
        const ivec2 offs[5] = ivec2[](ivec2(0, 0), ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
        for (int i = 0; i < 5; ++i) {
            const vec2 c = texelFetch(sampler2D(coarse, smp), clamp(cb + offs[i], ivec2(0), cgrid - 1), 0).xy * levelSize;
            const float k = cost(centre, c) + kSmooth * length(c - pred);
            if (k < bestCost) { bestCost = k; best = c; }
        }
    }

    const ivec2 hgrid = textureSize(sampler2D(history, smp), 0);
    if (hgrid.x > 1) {
        const vec2 huv = centre / levelSize;
        const ivec2 hb = clamp(ivec2(huv * vec2(hgrid)), ivec2(0), hgrid - 1);
        const vec2 h0 = texelFetch(sampler2D(history, smp), hb, 0).xy;
        const ivec2 hb1 = clamp(ivec2((huv - h0) * vec2(hgrid)), ivec2(0), hgrid - 1);
        const vec2 hc[2] = vec2[](h0 * levelSize, texelFetch(sampler2D(history, smp), hb1, 0).xy * levelSize);
        for (int i = 0; i < 2; ++i) {
            if (any(isnan(hc[i])) || dot(hc[i] - best, hc[i] - best) < 1.0) continue;
            const float k = cost(centre, hc[i]) + kSmooth * length(hc[i] - pred);
            if (k < bestCost) { bestCost = k; best = hc[i]; }
        }
    }

#ifdef WIDE
    const int radius = coarsest ? 4 : 8;
#else
    const int radius = coarsest ? 4 : 1;
#endif
    vec2 start = best;
    for (int y = -radius; y <= radius; ++y)
        for (int x = -radius; x <= radius; ++x) {
            if (x == 0 && y == 0) continue;
            const vec2 c = start + vec2(x, y);
            const float k = cost(centre, c) + kSmooth * length(c - pred) + (max(abs(x), abs(y)) > 3 ? kFarJump : 0.0);
            if (k < bestCost) { bestCost = k; best = c; }
        }
    start = best;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            if (x == 0 && y == 0) continue;
            const vec2 c = start + 0.5 * vec2(x, y);
            const float k = cost(centre, c) + kSmooth * length(c - pred);
            if (k < bestCost) { bestCost = k; best = c; }
        }
    imageStore(dst, b, vec4(best / levelSize, 0.0, 0.0));
}
